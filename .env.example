# 环境变量配置

# Server
SERVER_PORT=8080
GIN_MODE=debug
ADMIN_TOKEN=dev-admin-token

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=gitsense
DB_PASSWORD=gitsense
DB_NAME=gitsense
DB_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# GitHub API
GITHUB_TOKEN=

# Embedding — 重要：默认使用本地 MiniLM，不花钱
EMBEDDING_PROVIDER=local
OPENAI_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_SERVICE_HOST=localhost
EMBEDDING_SERVICE_PORT=8001
EMBEDDING_BATCH_SIZE=10

# Cache TTL (seconds)
CACHE_REPO_TTL=86400
CACHE_RECOMMENDATION_TTL=3600
CACHE_ECOSYSTEM_TTL=3600

# Trend Detection
ENABLE_TREND_RANKING=true
TREND_CACHE_TTL=43200

# Bootstrap Dataset
MIN_REPO_STARS=100
MIN_REPO_FORKS=10
REPO_ACTIVE_YEARS=2
BOOTSTRAP_MAX_DEPTH=2
BOOTSTRAP_WORKERS=3
